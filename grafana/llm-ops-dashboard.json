{
  "__inputs": [
    {
      "name": "DS_OPENSEARCH",
      "label": "OpenSearch (llm-traces)",
      "type": "datasource",
      "pluginId": "grafana-opensearch-datasource",
      "pluginName": "OpenSearch"
    }
  ],
  "title": "LLM Ops \u2014 RCA assistant",
  "uid": "llm-ops-rca",
  "tags": [
    "llmops",
    "opentelemetry",
    "genai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LLM latency p95",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120000
              },
              {
                "color": "red",
                "value": 300000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "name:gen_ai.completion",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "percentiles",
              "field": "duration_ms",
              "settings": {
                "percents": [
                  "95"
                ]
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "name",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Input tokens / question (avg)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "name:gen_ai.completion",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "attributes.gen_ai.usage.input_tokens"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "name",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Output tokens / question (avg)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "name:gen_ai.completion",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "attributes.gen_ai.usage.output_tokens"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "name",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Generation speed (tokens/s)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "name:gen_ai.completion",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "avg",
              "field": "attributes.gen_ai.tokens_per_s"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "name",
              "settings": {
                "size": "1",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "JSON output valid?",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "displayLabels": [
          "percent"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "name:rca.question",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "attributes.rca.valid_json",
              "settings": {
                "size": "5",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Spans by status (errors)",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "displayLabels": [
          "percent"
        ]
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "status",
              "settings": {
                "size": "5",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency per span over time (max, ms)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "duration_ms"
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "terms",
              "field": "name",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "_term",
                "min_doc_count": "1"
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "10m",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens per question over time",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "name:gen_ai.completion",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "max",
              "field": "attributes.gen_ai.usage.input_tokens"
            },
            {
              "id": "4",
              "type": "max",
              "field": "attributes.gen_ai.usage.output_tokens"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "10m",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Questions asked",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "${DS_OPENSEARCH}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "@timestamp",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "lucene",
          "query": "name:rca.question",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "raw_data",
              "settings": {
                "size": "100",
                "order": "desc",
                "useTimeRange": true
              }
            }
          ],
          "bucketAggs": []
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "@timestamp": true,
              "attributes.rca.question": true,
              "duration_ms": true,
              "attributes.rca.confidence": true,
              "attributes.rca.valid_json": true,
              "attributes.rca.alerts_matched": true,
              "status": true,
              "trace_id": true
            },
            "indexByName": {
              "@timestamp": 0,
              "attributes.rca.question": 1,
              "duration_ms": 2,
              "attributes.rca.confidence": 3,
              "attributes.rca.valid_json": 4,
              "attributes.rca.alerts_matched": 5,
              "status": 6,
              "trace_id": 7
            },
            "renameByName": {
              "attributes.rca.question": "question",
              "attributes.rca.confidence": "confidence",
              "attributes.rca.valid_json": "valid_json",
              "attributes.rca.alerts_matched": "alerts"
            }
          }
        }
      ]
    }
  ]
}